# ==============================================================================
# PROJETO FINAL - CONFIGURAÇÃO DE AMBIENTE (BACKEND API)
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# NUNCA comite arquivos .env contendo senhas ou chaves reais no controle de versão!
# ==============================================================================

# Perfil do Spring Boot (dev | test | prod)
APP_PROFILE=dev

# Porta HTTP exposta pela aplicação
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# BANCO DE DADOS (POSTGRESQL)
# ------------------------------------------------------------------------------
# URL JDBC do banco de dados (use o nome do serviço 'postgres' no Docker Compose)
DB_URL=jdbc:postgresql://postgres:5432/gestao_condominial_db
DB_USERNAME=postgres
DB_PASSWORD=alterar_para_senha_forte_em_producao

# Configuração da porta exposta do banco no host (apenas desenvolvimento)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# SEGURANÇA E AUTORIZAÇÃO (OAUTH2 / JWT)
# ------------------------------------------------------------------------------
# Credenciais do cliente OAuth2 (Basic Auth / Authorization Server)
CLIENT_ID=ancora-app
CLIENT_SECRET=alterar_para_client_secret_seguro_em_producao

# Caminhos dos pares de chaves RSA em formato PEM (gerados pelo script scripts/setup-dev.sh)
JWT_PRIVATE_KEY_PATH=/app/.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/.secrets/jwt-public.pem

# Duração dos tokens em segundos (Access Token: 30m / Refresh Token: 30d)
JWT_DURATION=1800
JWT_REFRESH_DURATION=2592000

# Client ID do Google Identity Services (Web OAuth2)
GOOGLE_CLIENT_ID=1093543407623-ch2dq0uh0bnvrhm6pkf6kd8v75bvr3a0.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# CORS & INTEGRAÇÃO COM FRONTEND
# ------------------------------------------------------------------------------
# Origens permitidas separadas por vírgula (sem barra final)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# URL base para recuperação de senha enviada aos usuários por email
PASSWORD_RECOVER_URI=http://localhost:5500/#/recover-password/
PASSWORD_RECOVER_TOKEN_MINUTES=30

# ------------------------------------------------------------------------------
# SERVIÇO DE EMAIL (SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=seu_email@dominio.com
EMAIL_PASSWORD=sua_senha_de_app_gmail

# ------------------------------------------------------------------------------
# CONTA ADMINISTRATIVA INICIAL (BOOTSTRAP DEV)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@ancora.com
ADMIN_PASSWORD=alterar_senha_admin_em_producao
