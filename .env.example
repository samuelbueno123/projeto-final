# Perfil da aplicação (dev | prod)
APP_PROFILE=dev

# Banco de dados
POSTGRES_DB=gestao_condominial_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=alterar_para_senha_forte_em_producao
POSTGRES_PORT=5433

DB_URL=jdbc:postgresql://postgres:5432/gestao_condominial_db
DB_USERNAME=postgres
DB_PASSWORD=alterar_para_senha_forte_em_producao

# Portas dos serviços
API_PORT=8080
FRONTEND_PORT=5500
PGADMIN_PORT=5050

# OAuth2 / JWT
CLIENT_ID=ancora-app
CLIENT_SECRET=alterar_para_client_secret_seguro_em_producao
JWT_PRIVATE_KEY_PATH=/app/.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/.secrets/jwt-public.pem
JWT_DURATION=1800
JWT_REFRESH_DURATION=2592000
GOOGLE_CLIENT_ID=1093543407623-ch2dq0uh0bnvrhm6pkf6kd8v75bvr3a0.apps.googleusercontent.com

# CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Frontend Build Args
API_BASE_URL=http://localhost:8080
GOOGLE_WEB_CLIENT_ID=1093543407623-ch2dq0uh0bnvrhm6pkf6kd8v75bvr3a0.apps.googleusercontent.com

# Email & Notificações
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=seu_email@dominio.com
EMAIL_PASSWORD=sua_senha_de_app_gmail
